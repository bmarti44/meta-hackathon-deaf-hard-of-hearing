# Evidence and secrets stay out of the repo (see GOAL.md)
.env
*.pem
*.key
data/*
!data/.gitkeep
__pycache__/
.venv/
.DS_Store

# family photos: deployed to the site bucket only, never committed
site/assets/family/
api/build/
api/lambda.zip
# explainer video + renders (contain family media): deploy-only
site/assets/video/
video/out/
video/narration/clips/
# rendered frames, family-media links and per-segment renders
video/render/dance/
video/render/family
video/out/
video/narration/clips/
site/assets/video/
# implant explainer listening clips (generated by site/tools/make_implant_audio.py)
site/assets/audio/implant/
# generated LibriSpeech demo audio (research/meta/listen_wer.py): deploy-only
site/assets/audio/

# interim checkpoints and resumable states stay local (project rule)
research/gen*/weights/*_step[0-9]*.pt
research/gen*/weights/*_state_*.pt
research/gen*/weights/*_val_partial.json

# Gen31 WiSE-FT blends are regenerable from Gen19 + the fine-tune (index.json is committed)
research/gen31/weights/blends/*.pt
